rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection (Profile, EXP, titles, settings)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Scores Collection (Leaderboards & high scores)
    match /scores/{scoreId} {
      allow read, write: if true;
    }

    // Songs & Charts Collection (Imported tracks & community charts)
    match /songs/{songId} {
      allow read, write: if true;
    }
  }
}

