rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection (Profile, EXP, titles, settings)
    match /users/{userId} {
      allow read, write: if true;

      // Private song charts: access is bound to a verified Firebase account.
      match /songs/{songId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create, update: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.id is string
          && request.resource.data.updatedAt is number;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Scores Collection (Leaderboards & high scores)
    match /scores/{scoreId} {
      allow read, write: if true;
    }

    // Songs & Charts Collection (Imported tracks & community charts)
    match /songs/{songId} {
      allow read, write: if true;
    }
  }
}

